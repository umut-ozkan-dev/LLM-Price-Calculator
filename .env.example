# Backend
CORS_ORIGINS=http://localhost:3000
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=

# Hard cap applied to /api/run max_output_tokens. Also the default when the client omits it.
MAX_OUTPUT_TOKENS_CAP=8192
DEFAULT_MAX_OUTPUT_TOKENS=1024
RATE_LIMIT_RUN=10/minute

# Output-length heuristic used when expected_output_tokens is omitted.
# low = max(LOW_MIN, round(LOW_RATIO * input_tokens))
# expected = max(EXPECTED_MIN, round(EXPECTED_RATIO * input_tokens))
# high = min(round(HIGH_RATIO * input_tokens), model max_output_tokens)
# Results are then ordered so low <= expected <= high.
ESTIMATE_OUTPUT_LOW_RATIO=0.10
ESTIMATE_OUTPUT_EXPECTED_RATIO=0.50
ESTIMATE_OUTPUT_HIGH_RATIO=2.0
ESTIMATE_OUTPUT_LOW_MIN=50
ESTIMATE_OUTPUT_EXPECTED_MIN=150
CHARS_PER_TOKEN=4

# Frontend (baked in at `next build` / `next dev` time)
NEXT_PUBLIC_API_URL=http://localhost:8010

# Host ports for docker compose. The API container listens on 8000 and is published on 8010.
BACKEND_PORT=8010
FRONTEND_PORT=3000
